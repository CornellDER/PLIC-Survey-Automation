e","WhiteSpace":"OFF","MobileFirst":true},"QuestionDescription":"Consider the analysis and outcomes of\u00a0the group's investigation. Please characterize each of the...","Choices":{"10":{"Display":"Other (Please describe)","TextEntry":"true","InputWidth":119,"TextEntryForceResponse":true},"79":{"Display":"Their explanations and descriptions of their methods"},"80":{"Display":"Their analysis and calculations"},"83":{"Display":"How similar the spring constant (k) values are"},"84":{"Display":"The size of the uncertainty in their data and the spring constant (k) values"}},"ChoiceGroups":{"cg_1":{"ChoiceGroupOrder":["79","80","83","84"],"GroupLabel":"Analysis and outcomes","Options":[]}},"ChoiceGroupOrder":["cg_1","10"],"ChoiceOrder":["79","80","83","84","10"],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":85,"NextAnswerId":11,"Answers":{"6":{"Display":"Weakness (1)"},"7":{"Display":"(2)"},"9":{"Display":"(3)"},"10":{"Display":"Strength (4)"}},"AnswerOrder":["6","7","9","10"],"ChoiceDataExportTags":false,"QuestionText_Unsafe":"<p><span style=\"font-size: 13.3333px;\">Consider the <b>analysis and outcomes <\/b>of<b>&nbsp;<\/b>the group's investigation. Please characterize each of the following aspects of Group 1's&nbsp;<b>analysis and outcomes&nbsp;<\/b>as either a strength or weakness of their methods.<\/span><\/p>","DataExportTag":"Q333","QuestionID":"QID333"}},{"SurveyID":"SV_3ej1HpRwjR63YKa","Element":"SQ","PrimaryAttribute":"QID334","SecondaryAttribute":"Overall, how effective do you think Group 1's method was for testing whether the data obey the mo...","TertiaryAttribute":null,"Payload":{"QuestionText":"Overall, how effective do you think Group 1's method was for testing whether the data obey the model? Use a scale where 1 means the method was very ineffective and 5 means the method was very effective.","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","LabelPosition":"BELOW"},"QuestionDescription":"Overall, how effective do you think Group 1's method was for testing whether the data obey the mo...","Choices":{"1":{"Display":"1 (very ineffective)"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5 (very effective)"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"DataVisibility":{"Private":false,"Hidden":false},"NextChoiceId":6,"NextAnswerId":1,"QuestionText_Unsafe":"Based on your assessment of the strengths and weaknesses of Group 1's methods, overall, how effective do you think Group 1's method was for testing whether the data obey the model?&nbsp;<span style=\"font-size: 13.3333px;\">Use a scale where 1 means the method was very ineffective and 5 means the method was very effective.<\/span>","DataExportTag":"Q1c","QuestionID":"QID334"}},{"SurveyID":"SV_3ej1HpRwjR63YKa","Element":"SQ","PrimaryAttribute":"QID335","SecondaryAttribute":"What feature was most important to you in evaluating the effectiveness of Group 1's methods (eith...","TertiaryAttribute":null,"Payload":{"QuestionText":"What feature was most important to you in evaluating the effectiveness of Group 1's methods (either as strengths or weaknesses)?","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"What feature was most important to you in evaluating the effectiveness of Group 1's methods (eith...","Choices":{"1":{"Display":"Data collection methods"},"2":{"Display":"Amount of data collected"},"5":{"Display":"Analysis and outcomes"},"6":{"Display":"Other","TextEntry":"true"}},"ChoiceOrder":["1","2","5","6"],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":8,"NextAnswerId":1,"DataVisibility":{"Private":false,"Hidden":false},"QuestionText_Unsafe":"What feature was most important to you in evaluating the effectiveness of Group 1's methods (either as strengths or weaknesses)?","DataExportTag":"Q335","QuestionID":"QID335"}},{"SurveyID":"SV_3ej1HpRwjR63YKa","Element":"SQ","PrimaryAttribute":"QID336","SecondaryAttribute":"What do you think Group 1 should do next? Choose the most important next steps (no more than two).","TertiaryAttribute":null,"Payload":{"QuestionText":"What do you think Group 1 should do next? Choose the most important next steps (no more than two).","QuestionType":"MC","Selector":"MAVR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"What do you think Group 1 should do next? Choose the most important next steps (no more than two).","Choices":{"1":{"Display":"Test or control other variables"},"2":{"Display":"Reduce uncertainty (e.g., more trials for the same masses, more bounces per trial, etc.)"},"3":{"Display":"Repeat the experiment with more and different masses"},"4":{"Display":"Use a different analysis (e.g., graph the results, incorporate systematic effects)"},"5":{"Display":"Check their work and write it up"},"6":{"Display":"Compare their k-values to the expected value"},"7":{"Display":"Other","TextEntry":"true"},"8":{"Display":"Design a new experiment to test the results"},"9":{"Display":"Repeat the experiment with better equipment"},"10":{"Display":"Account for human error"}},"ChoiceOrder":["1","2","10","3","9","4","6","8","5","7"],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"CustomValidation","CustomValidation":{"Logic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID336\/SelectedChoicesCount","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">What do you think Group 1 should do next? Choose the most important next steps (no more than two).<\/span> <span class=\"LeftOpDesc\">q:\/\/QID302\/SelectedChoicesCount<\/span> <span class=\"OpDesc\">Is Less Than or Equal to<\/span> <span class=\"RightOpDesc\"> 2 <\/span>","LeftOperand":"q:\/\/QID336\/SelectedChoicesCount","LogicType":"Question","Operator":"LessThanOrEqual","QuestionID":"QID336","QuestionIDFromLocator":"QID336","QuestionIsInLoop":"no","RightOperand":"2","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression"},"Message":{"description":"Too many 3","libraryID":"UR_bOXilo3mscFKVRr","messageID":"MS_3EmA84tU2IfZVYx","subMessageID":"VE_CUSTOM_VALIDATION_1"}}}},"Language":[],"NextChoiceId":11,"NextAnswerId":1,"DataVisibility":{"Private":false,"Hidden":false},"QuestionText_Unsafe":"What do you think Group 1 should do next? Choose the most important next steps (no more than two).","DataExportTag":"Q1e","QuestionID":"QID336"}},{"SurveyID":"SV_3ej1HpRwjR63YKa","Element":"SQ","PrimaryAttribute":"QID337","SecondaryAttribute":"You may use this space to explain or elaborate on any of your answers thus far. ","TertiaryAttribute":null,"Payload":{"QuestionText":"You may use this space to explain or elaborate on any of your answers thus far.&nbsp;","DefaultChoices":false,"QuestionType":"TE","Selector":"ML","Configuration":{"QuestionDescriptionOption":"UseText","InputWidth":680,"InputHeight":169},"QuestionDescription":"You may use this space to explain or elaborate on any of your answers thus far. ","Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"QuestionText_Unsafe":"You may use this space to explain or elaborate on any of your answers thus far.&nbsp;","DataExportTag":"Q1f","QuestionID":"QID337","DataVisibility":{"Private":false,"Hidden":false},"NextChoiceId":1,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"}}},{"SurveyID":"SV_3ej1HpRwjR63YKa","Element":"SQ","PrimaryAttribute":"QID338","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"GradingData":[],"Language":[],"QuestionText_Unsafe":"Timing","DataExportTag":"Qt1","QuestionID":"QID338","DataVisibility":{"Private":false,"Hidden":false},"NextChoiceId":21,"NextAnswerId":1}},{"SurveyID":"SV_3ej1HpRwjR63YKa","Element":"SQ","PrimaryAttribute":"QID339","SecondaryAttribute":"Below are the notes Group 2 made in their lab book. You will then be asked about their data and m...","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"color: rgb(64, 64, 64); font-family: &quot;Qualtrics Grotesque&quot;, &quot;Helvetica Neue&quot;, Helvetica, Arial, sans-serif; font-size: 15px; line-height: normal;\">Below are the notes Group 2 made in their lab book. You will then be asked about their data and methods.<\/span><br>\n<br>\n<strong><span style=\"font-size: 19px;\">Group 2: Lab book notes<\/span><\/strong>\n<div><strong><span style=\"font-family:Courier New,Courier,monospace;\"><span style=\"font-size:19px;\"><u>Method<\/u><\/span><\/span><\/strong><br>\n<span style=\"font-family:Courier New,Courier,monospace;\"><span style=\"font-size:16px;\">To test the model (<i>T=2<\/i>\u03c0\u221a(<i>m\u2044k<\/i>)), we used the stopwatch to measure two trials of the time for 5 bounces for 10 different masses (total mass 10 g to 100 g). For each mass, we found the mean between the two trials and divided the time by 5 to get the mean period.<br>\n<br>\nReaction time is about 0.1 s, so our uncertainty in the total time for each trial (5 bounces) is about 0.1 s, so we'll estimate the uncertainty in the mean period for each mass to be 0.02 s.<br>\n<br>\nBased on the equation, plotting our data as period squared (<i>T<sup>2<\/sup><\/i>) versus mass should give a straight line with an intercept through the origin. That is, squaring both sides of the equation gives <i> T<sup>2<\/sup>=4\u03c0<sup>2<\/sup>m\/k.<\/i><br>\n<br>\nIf we fix the y-intercept at 0, the slope of the line should be <i>4\u03c0<sup>2<\/sup>\/k.<\/i><br>\n<br>\nThe best-fit line gave a <i> slope = 9.8210 \u00b1 0.1690 m\/N<\/i><br>\nSo <i>k=4\u03c0<sup>2<\/sup>\/slope = 4.0198 \u00b1 0.0692 N\/m <\/i><br>\n<br>Here's our plot of the data and the fit line (uncertainties propagated):<\/span><\/span><br>\n<br>\n<img src=\"https:\/\/cornell.qualtrics.com\/CP\/Graphic.php?IM=IM_4U5B8kRQVuEmqpv\" style=\"width: 600px; height: 360px;\">&nbsp;<\/div>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Below are the notes Group 2 made in their lab book. You will then be asked about their data and m...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"QuestionText_Unsafe":"<span style=\"color: rgb(64, 64, 64); font-family: &quot;Qualtrics Grotesque&quot;, &quot;Helvetica Neue&quot;, Helvetica, Arial, sans-serif; font-size: 15px; line-height: normal;\">Below are the notes Group 2 made in their lab book. You will then be asked about their data and methods.<\/span><br>\n<br>\n<strong><span style=\"font-size: 19px;\">Group 2: Lab book notes<\/span><\/strong>\n<div><strong><span style=\"font-family:Courier New,Courier,monospace;\"><span style=\"font-size:19px;\"><u>Method<\/u><\/span><\/span><\/strong><br>\n<span style=\"font-family:Courier New,Courier,monospace;\"><span style=\"font-size:16px;\">To test the model (<i>T=2<\/i>\u03c0\u221a(<i>m\u2044k<\/i>)), we used the stopwatch to measure two trials of the time for 5 bounces for 10 different masses (total mass 10 g to 100 g). For each mass, we found the mean between the two trials and divided the time by 5 to get the mean period.<br>\n<br>\nReaction time is about 0.1 s, so our uncertainty in the total time for each trial (5 bounces) is about 0.1 s, so we'll estimate the uncertainty in the mean period for each mass to be 0.02 s.<br>\n<br>\nBased on the equation, plotting our data as period squared (<i>T<sup>2<\/sup><\/i>) versus mass should give a straight line with an intercept through the origin. That is, squaring both sides of the equation gives <i> T<sup>2<\/sup>=4\u03c0<sup>2<\/sup>m\/k.<\/i><br>\n<br>\nIf we fix the y-intercept at 0, the slope of the line should be <i>4\u03c0<sup>2<\/sup>\/k.<\/i><br>\n<br>\nThe best-fit line gave a <i> slope = 9.8210 \u00b1 0.1690 m\/N<\/i><br>\nSo <i>k=4\u03c0<sup>2<\/sup>\/slope = 4.0198 \u00b1 0.0692 N\/m <\/i><br>\n<br>Here's our plot of the data and the fit line (uncertainties propagated):<\/span><\/span><br>\n<br>\n<img src=\"https:\/\/cornell.qualtrics.com\/CP\/Graphic.php?IM=IM_4U5B8kRQVuEmqpv\" style=\"width: 600px; height: 360px;\">&nbsp;<\/div>","DataVisibility":{"Private":false,"Hidden":false},"NextChoiceId":1,"NextAnswerId":1,"DataExportTag":"Q2","QuestionID":"QID339"}},{"SurveyID":"SV_3ej1HpRwjR63YKa","Element":"SQ","PrimaryAttribute":"QID340","SecondaryAttribute":"What do you think Group 2 should say about whether their data agree with the model?","TertiaryAttribute":null,"Payload":{"QuestionText":"What do you think Group 2 should say about whether their data agree with the model?","DefaultChoices":false,"QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","LabelPosition":"BELOW"},"QuestionDescription":"What do you think Group 2 should say about whether their data agree with the model?","Choices":{"1":{"Display":"The data support the model."},"2":{"Display":"The data refute the model."},"3":{"Display":"The data neither support nor refute the model."},"4":{"Display":"There is not enough evidence to say either way."}},"ChoiceOrder":[1,"2","3","4"],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"DataVisibility":{"Private":false,"Hidden":false},"NextChoiceId":6,"NextAnswerId":1,"QuestionText_Unsafe":"What do you think Group 2 should say about whether their data agree with the model?","DataExportTag":"Q2a","QuestionID":"QID340"}},{"SurveyID":"SV_3ej1HpRwjR63YKa","Element":"SQ","PrimaryAttribute":"QID341","SecondaryAttribute":"Which statements below support your reasoning for whether Group 2's data agree with the model? Se...","TertiaryAttribute":null,"Payload":{"QuestionText":"Which statements below support your reasoning for whether Group 2's data agree with the model? Select the most important statements (no more than two).","DefaultChoices":false,"QuestionType":"MC","Selector":"MACOL","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","NumColumns":2,"TextPosition":"inline"},"QuestionDescription":"Which statements below support your reasoning for whether Group 2's data agree with the model? Se...","Choices":{"1":{"Display":"The data are approximately linear","InputHeight":29,"InputWidth":147},"2":{"Display":"The points are randomly scattered above and below the line"},"6":{"Display":"Many of the points cross the line (when considering their uncertainties)"},"8":{"Display":"The points are close to the line"},"9":{"Display":"There are very few outliers"},"11":{"Display":"The points are close to the line compared to the uncertainties"},"21":{"Display":"There are equal numbers of points above and below the line"},"36":{"Display":"The uncertainty in the points is small"},"38":{"Display":"Other (Please describe)","TextEntry":"true","InputHeight":29,"InputWidth":123},"39":{"Display":"The points are far from the line"},"40":{"Display":"The points are far from the line compared to the uncertainties"},"41":{"Display":"There are not equal numbers of points above and below the line"},"42":{"Display":"There is a pattern in how the points are scattered above and below the line"},"43":{"Display":"There are too many outliers"},"44":{"Display":"The uncertainty in the points is large"},"45":{"Display":"Too few points cross the line (when considering their uncertainties)"},"46":{"Display":"The data are curved (not linear)"}},"ChoiceOrder":["8","11","21","2","9","36","6","1","38","39","40","41","42","43","44","45","46"],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"CustomValidation","CustomValidation":{"Logic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID341\/SelectedChoicesCount","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">Which statements below support your reasoning for whether Group 2's data agree with the model? Select the most important statements (no more than two).<\/span> <span class=\"LeftOpDesc\">q:\/\/QID257\/SelectedChoicesCount<\/span> <span class=\"OpDesc\">Is Less Than or Equal to<\/span> <span class=\"RightOpDesc\"> 2 <\/span>","LeftOperand":"q:\/\/QID341\/SelectedChoicesCount","LogicType":"Question","Operator":"LessThanOrEqual","QuestionID":"QID341","QuestionIDFromLocator":"QID341","QuestionIsInLoop":"no","RightOperand":"2","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression"},"Message":{"description":"Too many 3","libraryID":"UR_bOXilo3mscFKVRr","messageID":"MS_3EmA84tU2IfZVYx","subMessageID":"VE_CUSTOM_VALIDATION_1"}}}},"GradingData":[],"Language":[],"PrivateData":false,"DataVisibility":{"Private":false,"Hidden":false},"NextChoiceId":47,"NextAnswerId":1,"QuestionText_Unsafe":"Which statements below support your reasoning for whether Group 2's data agree with the model? Select the most important statements (no more than two).<p><\/p>","DataExportTag":"Q2b","QuestionID":"QID341"}},{"SurveyID":"SV_3ej1HpRwjR63YKa","Element":"SQ","PrimaryAttribute":"QID342","SecondaryAttribute":"Reminder: please select no more than 2 options above.","TertiaryAttribute":null,"Payload":{"QuestionText":"Reminder: please select no more than 2 options above.","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseTex