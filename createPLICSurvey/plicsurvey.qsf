,"51":{"Display":"The variables measured: time and mass"},"55":{"Display":"The equipment used: stopwatches"},"69":{"Display":"The variables controlled: the spring"}},"ChoiceGroups":{"cg_1":{"ChoiceGroupOrder":["55","51","69"],"GroupLabel":"Data collection methods","Options":{"Selection":"MAWithinQuestion"}}},"ChoiceGroupOrder":["cg_1","10"],"ChoiceOrder":["55","51","69","10"],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":79,"NextAnswerId":11,"Answers":{"6":{"Display":"Weakness (1)"},"7":{"Display":"(2)"},"9":{"Display":"(3)"},"10":{"Display":"Strength (4)"}},"AnswerOrder":["6","7","9","10"],"ChoiceDataExportTags":false,"QuestionText_Unsafe":"<p><span style=\"font-size: 13.3333px;\">Consider the group's <b>data collection methods<\/b>.&nbsp;Please characterize each of the following aspects of Group 1\u2019s <b>data collection methods&nbsp;<\/b>as either a strength or weakness of their methods.<\/span><\/p>","DataExportTag":"Q331","QuestionID":"QID331"}},{"SurveyID":"SV_3ej1HpRwjR63YKa","Element":"SQ","PrimaryAttribute":"QID332","SecondaryAttribute":"Consider the amount of data the group collected. Please characterize each of the following aspect...","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><span style=\"font-size: 13.3333px;\">Consider the <b>amount of data <\/b>the group collected. Please characterize each of the following aspects of the <b>amount of data&nbsp;<\/b>Group 1 collected as either a strength or weakness of their methods.<\/span><\/p>","DefaultChoices":false,"QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","ChoiceColumnWidth":25,"RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true},"QuestionDescription":"Consider the amount of data the group collected. Please characterize each of the following as