estionDescriptionOption":"UseText","InputWidth":680,"InputHeight":169},"QuestionDescription":"You may use this space to explain or elaborate on any of your answers thus far. ","Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID72"}},{"SurveyID":"SV_3ej1HpRwjR63YKa","Element":"SQ","PrimaryAttribute":"QID74","SecondaryAttribute":"What do you think Group 2 should do next?\u00a0 Please select no more than 3 options.\u00a0","TertiaryAttribute":null,"Payload":{"QuestionText":"What do you think Group 2 should do next?&nbsp;<div>Please select no more than 3 options.&nbsp;<\/div>","DefaultChoices":false,"DataExportTag":"Q3e","QuestionID":"QID74","QuestionType":"MC","Selector":"MACOL","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","NumColumns":3,"TextPosition":"inline"},"QuestionDescription":"What do you think Group 2 should do next?\u00a0 Please select no more than 3 options.\u00a0","Choices":{"8":{"Display":"Other (please describe)","TextEntry":"true","InputHeight":24,"InputWidth":198,"TextEntryForceResponse":true},"11":{"Display":"Design a new experiment to test the non-zero intercept"},"13":{"Display":"Test other variables (e.g. impact of different amplitudes, different springs, spring deformation)"},"14":{"Display":"Test more masses"},"17":{"Display":"Take more trials for each mass"},"18":{"Display":"Redo the measurement of the last point"},"20":{"Display":"Increase the number of bounces per trial"},"21":{"Display":"Use better equipment (e.g. photogate, lasers)"},"22":{"Display":"Include other measures of uncertainty (e.g. stopwatch or ruler precision)"},"23":{"Display":"Find ways to reduce human error (e.g. view ruler straight on)"},"24":{"Display":"Try group 1's method"},"27":{"Display":"Change the fit or try another fit (either go back to old fit or try a new one)"},"28":{"Display":"Check the assumptions of the model or systematic effects"},"32":{"Display":"Write it up (theory, method, results, sources of error, conclusions)"},"34":{"Display":"Check their work for possible mistakes"},"36":{"Display":"Compare their k-values to the expected value"},"37":{"Display":"Remove the last point (outlier)"},"49":{"Display":"Use their k to predict and compare a new mass"}},"ChoiceOrder":["13","14","11","17","18","37","20","21","22","23","24","28","27","49","32","34","36","8"],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"CustomValidation","MinChoices":"","MaxChoices":"3","CustomValidation":{"Logic":{"0":{"0":{"QuestionID":"QID74","QuestionIsInLoop":"no","ChoiceLocator":"q:\/\/QID74\/SelectedChoicesCount","Operator":"LessThanOrEqual","QuestionIDFromLocator":"QID74","LeftOperand":"q:\/\/QID74\/SelectedChoicesCount","RightOperand":"3","Type":"Expression","LogicType":"Question","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">What do you think Group 2 should do next?&nbsp; Please select no more than 3 options.&nbsp;<\/span> <span class=\"LeftOpDesc\">q:\/\/QID74\/SelectedChoicesCount<\/span> <span class=\"OpDesc\">Is Less Than or Equal to<\/span> <span class=\"RightOpDesc\"> 3 <\/span>"},"Type":"If"},"Type":"BooleanExpression"},"Message":{"messageID":"MS_3EmA84tU2IfZVYx","subMessageID":"VE_CUSTOM_VALIDATION_1","libraryID":"UR_bOXilo3mscFKVRr","description":"Too many 3"}}}},"GradingData":[],"Language":[],"PrivateData":false,"DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_3ej1HpRwjR63YKa","Element":"SQ","PrimaryAttribute":"QID75","SecondaryAttribute":"Which items below best reflect your reasoning? Please select no more than 3 options.","TertiaryAttribute":null,"Payload":{"QuestionText":"Which items below best reflect your reasoning? Please select no more than 3 options.","DefaultChoices":false,"DataExportTag":"Q3d","QuestionID":"QID75","QuestionType":"MC","Selector":"MACOL","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","NumColumns":2,"TextPosition":"inline"},"QuestionDescription":"Which items below best reflect your reasoning? Please select no more than 3 options.","Choices":{"1":{"Display":"There may have been mistakes in the data collection"},"3":{"Display":"The model says the intercept should be zero (and they can't add a parameter just because the fit is better)"},"4":{"Display":"The ideal model doesn't really apply in the real world"},"5":{"Display":"There was likely an assumption made in the model that wasn't valid (or something was ignored)"},"6":{"Display":"The intercept is irrelevant in the investigation"},"7":{"Display":"The intercept is due to random uncertainty"},"8":{"Display":"The fit is better with the intercept fixed at zero"},"9":{"Display":"The intercept is due to human error"},"10":{"Display":"Other (please describe)","TextEntry":"true","InputHeight":24,"InputWidth":168,"TextEntryForceResponse":true},"11":{"Display":"The uncertainty in the k-value is better with the intercept fixed at zero","InputHeight":24,"InputWidth":250},"14":{"Display":"The uncertainty in the k-value is better with the intercept not fixed at zero"},"15":{"Display":"There might be a different model causing a trend at higher weights"},"16":{"Display":"The outliers should be addressed before drawing conclusions"},"19":{"Display":"The fit is better with the intercept not fixed at zero","InputHeight":24,"InputWidth":40},"20":{"Display":"They collected very good data"},"28":{"Display":"There is a linear relationship between mass and period-squared"},"29":{"Display":"The theoretical model is accurate"}},"ChoiceOrder":["1","8","19","11","7","9","5","10","29","15","20","28","14","6","16","4","3"],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"CustomValidation","MaxChoices":"3","CustomValidation":{"Logic":{"0":{"0":{"QuestionID":"QID75","QuestionIsInLoop":"no","ChoiceLocator":"q:\/\/QID75\/SelectedChoicesCount","Operator":"LessThanOrEqual","QuestionIDFromLocator":"QID75","LeftOperand":"q:\/\/QID75\/SelectedChoicesCount","RightOperand":"3","Type":"Expression","LogicType":"Question","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">Which items below are possible conclusions Group 2 may be able to draw from their investigation s...<\/span> <span class=\"LeftOpDesc\">q:\/\/QID75\/SelectedChoicesCount<\/span> <span class=\"OpDesc\">Is Less Than or Equal to<\/span> <span class=\"RightOpDesc\"> 3 <\/span>"},"Type":"If"},"Type":"BooleanExpression"},"Message":{"messageID":"MS_3EmA84tU2IfZVYx","subMessageID":"VE_CUSTOM_VALIDATION_1","libraryID":"UR_bOXilo3mscFKVRr","description":"Too many 3"}}}},"GradingData":[],"Language":[],"DataVisibility":{"Private":false}}},{"SurveyID":"SV_3ej1HpRwjR63YKa","Element":"SQ","PrimaryAttribute":"QID76","SecondaryAttribute":"Based on your assessment of the strengths and weaknesses of Team Panda's methods, overall, how ef...","TertiaryAttribute":null,"Payload":{"QuestionText":"Based on your assessment of the strengths and weaknesses of Team Panda's methods, overall, how effective do you think Team Panda's method was for testing whether the data obey the model? Use a scale where 1 means the method was very ineffective and 5 means the method was very effective.","DefaultChoices":false,"DataExportTag":"Q1c","QuestionID":"QID76","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","LabelPosition":"BELOW"},"QuestionDescription":"Based on your assessment of the strengths and weaknesses of Team Panda's methods, overall, how ef...","Choices":{"1":{"Display":"1 (very ineffective)"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5 (very effective)"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"DataVisibility":{"Private":false,"Hidden":false},"NextChoiceId":6,"NextAnswerId":1}},{"SurveyID":"SV_3ej1HpRwjR63YKa","Element":"SQ","PrimaryAttribute":"QID77","SecondaryAttribute":"Based on your assessment of the strengths and weaknesses of Team Ostrich's methods, overall, how...","TertiaryAttribute":null,"Payload":{"QuestionText":"Based on your assessment of the strengths and weaknesses of Team Ostrich's methods, overall, how effective do you think Team Ostrich's method was for testing whether the data obey the model? Use a scale where 1 means the method was very ineffective and 5 means the method was very effective.","DefaultChoices":false,"DataExportTag":"Q2c","QuestionID":"QID77","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","LabelPosition":"BELOW"},"QuestionDescription":"Based on your assessment of the strengths and weaknesses of Team Ostrich's methods, overall, how...","Choices":{"1":{"Display":"1 (very ineffective)"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5 (very effective)"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"DataVisibility":{"Private":false,"Hidden":false},"NextChoiceId":6,"NextAnswerId":1}},{"SurveyID":"SV_3ej1HpRwjR63YKa","Element":"SQ","PrimaryAttribute":"QID79","SecondaryAttribute":"What do you think Group 2 should say about whether their data agree with the model?","TertiaryAttribute":null,"Payload":{"QuestionText":"What do you think Group 2 should say about whether their data agree with the model?","DefaultChoices":false,"DataExportTag":"Q3a","QuestionID":"QID79","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","LabelPosition":"BELOW"},"QuestionDescription":"What do you think Group 2 should say about whether their data agree with the model?","Choices":{"1":{"Display":"The data support the model."},"2":{"Display":"The data refute the model."},"3":{"Display":"The data neither support nor refute the model."},"4":{"Display":"There is not enough evidence to say either way."}},"ChoiceOrder":[1,"2","3","4"],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"DataVisibility":{"Private":false,"Hidden":false},"NextChoiceId":6,"NextAnswerId":1}},{"SurveyID":"SV_3ej1HpRwjR63YKa","Element":"SQ","PrimaryAttribute":"QID82","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"QtEthics","QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"GradingData":[],"Language":[],"QuestionID":"QID82"}},{"SurveyID":"SV_3ej1HpRwjR63YKa","Element":"SQ","PrimaryAttribute":"QID83","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"QtIntro","QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"GradingData":[],"Language":[],"QuestionID":"QID83"}},{"SurveyID":"SV_3ej1HpRwjR63YKa","Element":"SQ","PrimaryAttribute":"QID85","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"Qt2","QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"GradingData":[],"Language":[],"QuestionID":"QID85"}},{"SurveyID":"SV_3ej1HpRwjR63YKa","Element":"SQ","PrimaryAttribute":"QID86","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"Qt3","QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"GradingData":[],"Language":[],"QuestionID":"QID86"}},{"SurveyID":"SV_3ej1HpRwjR63YKa","Element":"SQ","PrimaryAttribute":"QID87","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"Qt4","QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"GradingData":[],"Language":[],"QuestionID":"QID87"}},{"SurveyID":"SV_3ej1HpRwjR63YKa","Element":"SQ","PrimaryAttribute":"QID9","SecondaryAttribute":"\u200bMass on a spring experiment In the following questions, you will explore two groups of physicist.","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong><span style=\"font-size:19px;\">\u200bMass on a spring experiment<\/span><\/strong><br>\nIn the following questions, you will explore two groups of physicists conducting an experiment about a mass on a spring.<br>\n<br>\nThey are using a mass, <i>m<\/i>, hanging from a spring with spring constant, <i>k<\/i>. If the mass is pulled down from the spring's equilibrium position, it will oscillate with a period, <i>T. <\/i>The physicists are testing a model that predicts the period through&nbsp;the equation <i>T=2<\/i>\u213c\u221a(<i>m\u2044k<\/i>).<br>\n<br>\nThe two groups of physicists are designing and carrying out experiments to test how well a mass on a spring obeys this model. They are able to come up with their own experimental designs and the pictures below show their basic setup. They have the following equipment available to them:\n<ul>\n\t<li>a digital stopwatch (0.01 s increments),<\/li>\n\t<li>a spring with unknown spring constant, <i>k<\/i>,<\/li>\n\t<li>a mass holder (10 g) attached to the spring,<\/li>\n\t<li>a set of standardized masses, and<\/li>\n\t<li>a ruler attached to the spring holder (1 mm increments).<\/li>\n<\/ul>\nThe following questions will ask you about the two teams' experiments. You will be free to move backwards and forwards through the questions.<br>\n<img height=\"415\" src=\"https:\/\/cornell.qualtrics.com\/CP\/Graphic.php?IM=IM_9t1NLCv815TD4B7\" style=\"width: 391px; height: 415px; float: left;\" width=\"391\">","DefaultChoices":false,"DataExportTag":"Intro","QuestionID":"QID9","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"\u200bMass on a spring experiment In the following questions, you will explore two groups of physicist...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"DataVisibility":{"Private":false,"Hidden":false},"NextChoiceId":1,"NextAnswerId":1}},{"SurveyID":"SV_3ej1HpRwjR63YKa","Element":"SQ","PrimaryAttribute":"QID95","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"QtDem","QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"GradingData":[],"Language":[],"QuestionID":"QID95"}},{"SurveyID":"SV_3ej1HpRwjR63YKa","Element":"SQ","PrimaryAttribute":"QID97","SecondaryAttribute":"Below are the notes Group 1 made in their lab book. You will then be asked about their data and m...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div>Below are the notes Group 1 made in their lab book. You will then be asked about their data and methods. Click <a href=\"https:\/\/cornell.qualtrics.com\/CP\/Graphic.php?IM=IM_cVnx10pGM7eFWZL\">here<\/a> to see the introduction again.<\/div>\n\n<div>&nbsp;<\/div>\n<strong><span style=\"font-size:19px;\"><span style=\"font-family:arial,helvetica,sans-serif;\">Group 1: Lab book notes<\/span><\/span><\/strong>\n\n<div><img src=\"https:\/\/stanforduniversity.qualtrics.com\/CP\/Graphic.php?IM=IM_6niQ1OxSRh2yzfn\" style=\"width: 1005px; height: 722px;\" \/><\/div>","DefaultChoices":false,"DataExportTag":"Q1","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Below are the notes Group 1 made in their lab book. You will then be asked about their data and m...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID97"}},{"SurveyID":"SV_3ej1HpRwjR63YKa","Element":"SQ","PrimaryAttribute":"QID98","SecondaryAttribute":"How similar or different do you think Group 1's spring constant (k)\u00a0values are?\u00a0 Use a scale wher.","TertiaryAttribute":null,"Payload":{"QuestionText":"How similar or different do you think Group 1's spring constant (k)&nbsp;values are?&nbsp;<div>Use a scale where 1 means the values are not different at all and 5 means the values are very different.<\/div>","DefaultChoices":false,"DataExportTag":"Q1a","QuestionID":"QID98","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","LabelPosition":"BELOW"},"QuestionDescription":"How similar or different do you think Group 1's spring constant (k)\u00a0values are?\u00a0 Use a scale wher...","Choices":{"1":{"Display":"1 (not different at all)"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5 (very different)"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[]}},{"SurveyID":"SV_3ej1HpRwjR63YKa","Element":"SQ","PrimaryAttribute":"QID99","SecondaryAttribute":"What features were most important in comparing the two k values?","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"color: rgb(39, 39, 39); font-family: Helvetica; font-size: 13px;\">What features were most important in comparing the two k values?<\/span>","DefaultChoices":false,"DataExportTag":"Q1b","QuestionType":"TE","Selector":"ML","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"What features were most important in comparing the two k values?","Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID99"}},{"SurveyID":"SV_3ej1HpRwjR63YKa","Element":"STAT","PrimaryAttribute":"Survey Statistics","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"MobileCompatible":true,"ID":"Survey Statistics"}}]}