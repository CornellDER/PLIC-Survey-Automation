 the following ways?\nEnter a percentage of time for each option below where 0% is \"Never\" and 100% is \"Always\". Your percentages should add up to 100%.","DefaultChoices":false,"DataExportTag":"QDem_RoleDist_Alt","QuestionID":"QID386","QuestionType":"Matrix","Selector":"CS","SubSelector":"WVTB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","ChoiceColumnWidth":25,"RepeatHeaders":"none","MobileFirst":true,"ChoiceColumnWidthPixels":597,"CSSliderMin":0,"CSSliderMax":100},"QuestionDescription":"During your time in the lab, how frequently did your group organize physical, hands-on lab roles...","Choices":{"1":{"Display":"We worked together on roles (for example, so that we could bounce ideas off each other for each role)"},"2":{"Display":"We divided the roles and <strong>rotated<\/strong> who worked on each role (for example, so that everyone could learn about and experience every role)"},"3":{"Display":"We divided the roles and kept the <strong>same<\/strong> roles each week (for example, so that each person could do what they enjoyed or were experienced with)"},"4":{"Display":"Other"}},"ChoiceOrder":["1","2","3","4"],"Validation":{"Settings":{"EnforceRange":"OFF","ForceResponse":"OFF","ForceResponseType":"ON","Type":"ChoicesTotal","ChoiceTotal":"100"}},"GradingData":[],"Language":[],"NextChoiceId":5,"NextAnswerId":4,"Answers":{"1":{"Display":"&nbsp;"}},"AnswerOrder":["1"],"ChoiceDataExportTags":false,"ClarifyingSymbolType":"After","ClarifyingSymbol":"%","QuestionJS":"Qualtrics.SurveyEngine.addOnReady(function () {\n    let quest = this;\n    let qc = quest.getQuestionContainer();\n    let inputs = qc.querySelectorAll('.InputText');\n\n    function allZeros() {\n        for (let input of inputs) {\n            let val = parseFloat(input.value);\n            if (!isNaN(val) && val !== 0) {\n                return false;\n            }\n        }\n        return true;\n    }\n\n    Qualtrics.SurveyEngine.addOnPageSubmit(function (type) {\n        if (allZeros()) {\n            \/\/ Allow skipping if all zeros\n            return true;\n        }\n\n        \/\/ Validate each input 0 to 100\n        for (let input of inputs) {\n            let val = parseFloat(input.value);\n            if (isNaN(val) || val < 0 || val > 100) {\n                alert(\"Each value must be between 0 and 100.\");\n                return false; \/\/ blocks submission\n            }\n        }\n\n        \/\/ Validate sum = 100\n        let sum = 0;\n        inputs.forEach(input => {\n            sum += parseFloat(input.value) || 0;\n        });\n\n        if (sum !== 100) {\n            alert(\"The total must equal 100.\");\n            return false; \/\/ blocks submission\n        }\n\n        \/\/ All good\n        return true;\n    });\n});"}},{"SurveyID":"SV_3ej1HpRwjR63YKa","Element":"SQ","PrimaryAttribute":"QID387","SecondaryAttribute":"Click to write the question text","TertiaryAttribute":null,"Payload":{"QuestionText":"Click to write the question text","DataExportTag":"Q219","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Click to write the question text","Choices":{"1":{"Display":"Click to write Choice 1"},"2":{"Display":"Click to write Choice 2"},"3":{"Display":"Click to write Choice 3"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID387"}},{"SurveyID":"SV_3ej1HpRwjR63YKa","Element":"SQ","PrimaryAttribute":"QID388","SecondaryAttribute":"Click to write the question text","TertiaryAttribute":null,"Payload":{"QuestionText":"Click to write the question text","DefaultChoices":false,"DataExportTag":"Q220","QuestionID":"QID388","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidd