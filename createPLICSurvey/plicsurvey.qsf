y":"true"}},"ClarifyingSymbol":"%","ClarifyingSymbolType":"After","Configuration":{"CSSliderMax":100,"CSSliderMin":0,"GridLines":10,"NumDecimals":"0","QuestionDescriptionOption":"UseText","SliderStartPositions":{"1":0,"3":0,"5":0,"8":0,"10":0,"11":0}},"DataExportTag":"QDem_RoleDist","DataVisibility":{"Hidden":false,"Private":false},"DefaultChoices":false,"GradingData":[],"Labels":{"2":{"Display":"Never"},"3":{"Display":"Always"}},"Language":[],"NextAnswerId":4,"NextChoiceId":6,"QuestionDescription":"During your time in the lab, how frequently did your group organize\u00a0physical, hands-on lab roles...","QuestionID":"QID382","QuestionText":"During your time in the lab, how frequently did your group organize&nbsp;<strong>physical, hands-on lab roles<\/strong> (equipment, notes, and analysis) in the following ways?<br>\nEnter a percentage of time for each option below where 0% is \"Never\" and 100% is \"Always\". Your percentages should add up to 100%.","QuestionText_Unsafe":"During your time in the lab, how frequently did your group organize&nbsp;<strong>physical, hands-on lab roles<\/strong> (equipment, notes, and analysis) in the following ways?<br>\nEnter a percentage of time for each option below where 0% is \"Never\" and 100% is \"Always\". Your percentages should add up to 100%.","QuestionType":"CS","Selector":"VRTL","SubSelector":"TX","Validation":{"Settings":{"EnforceRange":"ON","Type":"None","ChoiceTotal":"100","CustomValidation":{"Logic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID382\/ChoiceNumericEntryValue\/1","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">During your time in the lab, how frequently did your group organize&nbsp;physical, hands-on lab roles...<\/span> <span class=\"LeftOpDesc\">We worked together on roles (for example, so that we could bounce ideas off each other for each role)<\/span> <span class=\"OpDesc\">Is Greater Than or Equal to<\/span> <span class=\"RightOpDesc\"> 0 <\/span>","LeftOperand":"q:\/\/QID382\/ChoiceNumericEntryValue\/1","LogicType":"Question","Operator":"GreaterThanOrEqual","QuestionID":"QID382","QuestionIDFromLocator":"QID382","QuestionIsInLoop":"no","RightOperand":"0","Type":"Expression"},"1":{"ChoiceLocator":"q:\/\/QID382\/ChoiceNumericEntryValue\/1","Conjuction":"And","Description":"<span class=\"ConjDesc\">And<\/span> <span class=\"QuestionDesc\">During your time in the lab, how frequently did your group organize&nbsp;physical, hands-on lab roles...<\/span> <span class=\"LeftOpDesc\">We worked together on roles (for example, so that we could bounce ideas off each other for each role)<\/span> <span class=\"OpDesc\">Is Less Than or Equal to<\/span> <span class=\"RightOpDesc\"> 100 <\/span>","LeftOperand":"q:\/\/QID382\/ChoiceNumericEntryValue\/1","LogicType":"Question","Operator":"LessThanOrEqual","QuestionID":"QID382","QuestionIDFromLocator":"QID382","QuestionIsInLoop":"no","RightOperand":"100","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression"},"Message":{"description":"Error incorrect page","libraryID":"GR_e5lRyUqe7qaGsuM","messageID":"MS_0ohtOHCzhbrjmrb","subMessageID":"VE_CUSTOM_VALIDATION_1"}}}},"DynamicChoicesData":[],"QuestionJS":"Qualtrics.SurveyEngine.addOnload(function () {\n    const container = this.getQuestionContainer();\n\n    \/\/ Create reminder div and style it\n    let reminder = document.createElement(\"div\");\n    reminder.id = \"sumReminder\";\n    reminder.style.color = \"black\";\n    reminder.style.marginTop = \"0px\";\n    reminder.style.display = \"none\";\n\treminder.style.fontSize = \"22px\";\n    reminder.innerText = \"  Reminder: please ensure your answers above sum to 100%.\";\n\n    \/\/ Append reminder div after the question container\n    container.parentNode.insertBefore(reminder, container.nextSibling);\n\n    const inputs = container.querySelectorAll(\"input[type='text']\");\n    if (inputs.length < 4) return;\n\n    const getValue = (index) => {\n        if (inputs[index]) {\n            let val = inputs[index].value.replace(\"%\", \"\").trim();\n            let num = parseFloat(val);\n            return isNaN(num) ? 0 : num;\n        }\n        return 0;\n    };\n\n    const validateSum = () => {\n        const sum = getValue(0) + getValue(1) + getValue(2) + getValue(3);\n        const roundedSum = Math.round(sum * 1000) \/ 1000;\n\n        if (roundedSum === 100 || roundedSum === 0) {\n            reminder.style.display = \"none\";\n        } else {\n            reminder.style.display = \"block\";\n        }\n    };\n\n    inputs.forEach(input => {\n        input.addEventListener(\"input\", () => {\n            setTimeout(validateSum, 100);\n        });\n    });\n\n    setTimeout(validateSum, 300);\n});"}},{"SurveyID":"SV_3ej1HpRwjR63YKa","Element":"SQ","PrimaryAttribute":"QID383","SecondaryAttribute":"Click to write the question text","TertiaryAttribute":null,"Payload":{"QuestionText":"Click to write the question text","DefaultChoices":false,"DataExportTag":"Q215","QuestionID":"QID383","QuestionType":"CS","Selector":"VRTL","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Click to write the question text","Choices":{"1":{"Display":"Click to write Choice 1"},"2":{"Display":"Click to write Choice 2"},"3":{"Display":"Click to write Choice 3"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"EnforceRange":"OFF","Type":"None","ForceResponse":"OFF","ChoiceTotal":"100"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"Labels":[],"ClarifyingSymbolType":"None"}},{"SurveyID":"SV_3ej1HpRwjR63YKa","Element":"SQ","PrimaryAttribute":"QID384","SecondaryAttribute":"Testing!","TertiaryAttribute":null,"Payload":{"QuestionText":"Testing!","DefaultChoices":false,"DataExportTag":"QDem_l","QuestionID":"QID384","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionD