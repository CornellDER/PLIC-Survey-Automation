uration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Please select no more than 2 options above.","InPageDisplayLogic":{"0":{"0":{"QuestionID":"QID201","QuestionIsInLoop":"no","ChoiceLocator":"q:\/\/QID201\/SelectedChoicesCount","Operator":"GreaterThan","QuestionIDFromLocator":"QID201","LeftOperand":"q:\/\/QID201\/SelectedChoicesCount","RightOperand":"2","Type":"Expression","LogicType":"Question","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">What do you think Group 2 should do next?&amp;nbsp;Please select no more than 2 options.<\/span> <span class=\"LeftOpDesc\">q:\/\/QID201\/SelectedChoicesCount<\/span> <span class=\"OpDesc\">Is Greater Than<\/span> <span class=\"RightOpDesc\"> 2 <\/span>"},"Type":"If"},"Type":"BooleanExpression","inPage":true},"ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID248"}},{"SurveyID":"SV_3ej1HpRwjR63YKa","Element":"SQ","PrimaryAttribute":"QID249","SecondaryAttribute":"Please select no more than 3 options above.","TertiaryAttribute":null,"Payload":{"QuestionText":"Please select no more than 3 options above.","DefaultChoices":false,"DataExportTag":"Q3b_l","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Please select no more than 3 options above.","InPageDisplayLogic":{"0":{"0":{"QuestionID":"QID166","QuestionIsInLoop":"no","ChoiceLocator":"q:\/\/QID166\/SelectedChoicesCount","Operator":"GreaterThan","QuestionIDFromLocator":"QID166","LeftOperand":"q:\/\/QID166\/SelectedChoicesCount","RightOperand":"3","Type":"Expression","LogicType":"Question","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">What features were most important in comparing the fit to the data? Please select no more than 3...<\/span> <span class=\"LeftOpDesc\">q:\/\/QID166\/SelectedChoicesCount<\/span> <span class=\"OpDesc\">Is Greater Than<\/span> <span class=\"RightOpDesc\"> 3 <\/span>"},"Type":"If"},"Type":"BooleanExpression","inPage":true},"ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID249","PrivateData":false}},{"SurveyID":"SV_3ej1HpRwjR63YKa","Element":"SQ","PrimaryAttribute":"QID25","SecondaryAttribute":"Below are additional notes Group 2 made in their lab book. You will then be asked about their dat...","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"color: rgb(64, 64, 64); font-family: &quot;Qualtrics Grotesque&quot;, &quot;Helvetica Neue&quot;, Helvetica, Arial, sans-serif; font-size: 15px; line-height: normal;\">Below are additional notes Group 2 made in their lab book. You will then be asked about their data and methods.<\/span>\n<div><br>\n<span style=\"font-size:19px;\"><strong>Group 2: Lab book notes (continued)<\/strong><\/span><br>\n<span style=\"font-family:Courier New,Courier,monospace;\"><span style=\"font-size:16px;\">What happens if we add a non-zero intercept to the fit? This gives the new graph below and:<br>\nNew slope = <i> 8.5862 \u00b1 0.0143 m\/N <\/i><br>\nSo new <i> k = 4\u03c0<sup>2<\/sup>\/slope = 4.5979 \u00b1 0.0077&nbsp;N\/m <\/i><br>\nAnd intercept = <i> 0.0720 \u00b1 0.298 s<sup>2<\/sup><\/i><\/span><\/span><br>\n<br>\n<img src=\"https:\/\/cornell.qualtrics.com\/CP\/Graphic.php?IM=IM_4OcjfNw3GsjzyrX\" style=\"width: 600px; height: 360px;\"><\/div>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Below are additional notes Group 2 made in their lab book. You will then be asked about their dat...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"QuestionText_Unsafe":"<img src=\"https:\/\/stanforduniversity.qualtrics.com\/CP\/Graphic.php?IM=IM_5vhDDuXceYEMroV\" style=\"width: 250px; height: 179px; float: right;\"><span style=\"font-family:courier new,courier,monospace;\"><span style=\"font-size:19px;\"><strong>Method<\/strong><\/span><br>\nMeasure time for 5 oscillations with different masses (10g to 100g).<\/span>\n<div>&nbsp;<\/div>\n\n<div><span style=\"font-family:courier new,courier,monospace;\">Stopwatch uncertainty is about 0.1s<\/span><\/div>\n\n<div>&nbsp;<\/div>\n\n<div><span style=\"font-family:courier new,courier,monospace;\">Plot of period (<em>T<\/em>) versus \\( \\sqrt{mass}\\) should give a straight line (top graph)<\/span><\/div>\n\n<div>&nbsp;<\/div>\n\n<div><span style=\"font-family:courier new,courier,monospace;\">Fix y-intercept at 0 and the slope should be \\( \\frac{2*pi}{\\sqrt{k}}\\)<\/span><\/div>\n\n<div>&nbsp;<\/div>\n\n<div><span style=\"font-family:courier new,courier,monospace;\">Residual plot (bottom) shows how far each data point is from the line.<\/span><img src=\"https:\/\/stanforduniversity.qualtrics.com\/CP\/Graphic.php?IM=IM_0BrEKYYEBZ11eHH\" style=\"opacity: 0.9; width: 250px; height: 214px; float: right;\"><\/div>\n\n<div>&nbsp;<\/div>\n\n<div><span style=\"font-family: 'courier new', courier, monospace;\">slope = 3.1323 \\( \\pm\\) 0.02697 m\/N =&nbsp;<\/span><span style=\"font-family: 'courier new', courier, monospace;\">\\( \\frac{2*pi}{\\sqrt(k)}\\)<\/span><\/div>\n\n<div>&nbsp;<\/div>\n\n<div><span style=\"font-family:courier new,courier,monospace;\">\u21d2 \\( k=&nbsp;(\\frac{2\\pi}{slope})^2 =&nbsp;4.02386 \\pm&nbsp;0.0693 N\/m \\)<\/span><\/div>","DataExportTag":"Q3","QuestionID":"QID25","DataVisibility":{"Private":false,"Hidden":false},"NextChoiceId":1,"NextAnswerId":1}},{"SurveyID":"SV_3ej1HpRwjR63YKa","Element":"SQ","PrimaryAttribute":"QID250","SecondaryAttribute":"Please select no more than 2 options above.","TertiaryAttribute":null,"Payload":{"QuestionText":"Please select no more than 2 options above.","DefaultChoices":false,"DataExportTag":"Q3d_l","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Please select no more than 2 options ab