br \/>\n<span style=\"font-size:19px;\"><strong>Group 2: Lab book notes (continued)<\/strong><\/span><br \/>\n<span style=\"font-family:Courier New,Courier,monospace;\"><span style=\"font-size:16px;\">What happens if we add a non-zero intercept to the fit? This gives the new graph below and:<br \/>\nNew slope = <i> 8.5862 &plusmn; 0.0143 m\/N <\/i><br \/>\nSo new <i> k = 4&pi;<sup>2<\/sup>\/slope = 4.5979 &plusmn; 0.0077&nbsp;N\/m <\/i><br \/>\nAnd intercept = <i> 0.0720 &plusmn; 0.298 s<sup>2<\/sup><\/i><\/span><\/span><br \/>\n<br \/>\n<img src=\"https:\/\/cornell.qualtrics.com\/CP\/Graphic.php?IM=IM_4OcjfNw3GsjzyrX\" style=\"width: 600px; height: 360px;\" \/><\/div>","DataVisibility":{"Private":false,"Hidden":false},"NextChoiceId":1,"NextAnswerId":1,"DataExportTag":"Q352","QuestionID":"QID352"}},{"SurveyID":"SV_3ej1HpRwjR63YKa","Element":"SQ","PrimaryAttribute":"QID353","SecondaryAttribute":"What do you think Group 2 should say about whether their data agree with the model?","TertiaryAttribute":null,"Payload":{"QuestionText":"What do you think Group 2 should say about whether their data agree with the model?","DefaultChoices":false,"QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","LabelPosition":"BELOW"},"QuestionDescription":"What do you think Group 2 should say about whether their data agree with the model?","Choices":{"1":{"Display":"The data support the model."},"2":{"Display":"The data refute the model."},"3":{"Display":"The data neither support nor refute the model."},"4":{"Display":"There is not enough evidence to say either way."}},"ChoiceOrder":[1,"2","3","4"],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"DataVisibility":{"Private":false,"Hidden":false},"NextChoiceId":6,"NextAnswerId":1,"QuestionText_Unsafe":"What do you think Group 2 should say about whether their data agree with the model?","D