"UseText","TextPosition":"inline","ChoiceColumnWidth":25,"RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true},"QuestionDescription":"Consider the group's data collection methods.\u00a0Please characterize each of the following aspects o...","Choices":{"10":{"Display":"Other (Please describe)","TextEntry":"true","InputWidth":119,"TextEntryForceResponse":true},"51":{"Display":"The group measured time and mass (and no other variables)"},"55":{"Display":"The group used stopwatches to measure the time"},"69":{"Display":"The group controlled for the mass (and no other variables) between trials"}},"ChoiceGroups":{"cg_1":{"ChoiceGroupOrder":["55","51","69"],"GroupLabel":"Data collection methods","Options":{"Selection":"MAWithinQuestion"}}},"ChoiceGroupOrder":["cg_1","10"],"ChoiceOrder":["55","51","69","10"],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":79,"NextAnswerId":11,"Answers":{"6":{"Display":"Weakness (1)"},"7":{"Display":"(2)"},"9":{"Display":"(3)"},"10":{"Display":"Strength (4)"}},"AnswerOrder":["6","7","9","10"],"ChoiceDataExportTags":false,"QuestionID":"QID323"}},{"SurveyID":"SV_3ej1HpRwjR63YKa","Element":"SQ","PrimaryAttribute":"QID324","SecondaryAttribute":"Consider the amount of data the group collected. Please characterize each of the following aspect...","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><span style=\"font-size: 13.3333px;\">Consider the <b>amount of data <\/b>the group collected. Please characterize each of the following aspects of <b>the amount of data&nbsp;<\/b>Group 1 collected as either a strength or weakness of their methods.<\/span><\/p>","DefaultChoices":false,"DataExportTag":"Q156","QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","ChoiceColumnWidth":25,"RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true},"QuestionDescription":"Consider the amount of data the group collected. Please characterize each of the following aspect...","Choices":{"10":{"Display":"Other (Please describe)","TextEntry":"true","InputWidth":119,"TextEntryForceResponse":true},"79":{"Display":"The group collected 10 repeated trials for each mass"},"80":{"Display":"The group tested 2 different masses"},"81":{"Display":"The group measured the time for 5 bounces of bounces of the spring per trial"}},"ChoiceGroups":{"cg_1":{"ChoiceGroupOrder":["79","80","81"],"GroupLabel":"Amount of data","Options":[]}},"ChoiceGroupOrder":["cg_1","10"],"ChoiceOrder":["79","80","81","10"],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":82,"NextAnswerId":11,"Answers":{"6":{"Display":"Weakness (1)"},"7":{"Display":"(2)"},"9":{"Display":"(3)"},"10":{"Display":"Strength (4)"}},"AnswerOrder":["6","7","9","10"],"ChoiceDataExportTags":false,"QuestionID":"QID324"}},{"SurveyID":"SV_3ej1HpRwjR63YKa","Element":"SQ","PrimaryAttribute":"QID325","SecondaryAttribute":"Consider the analysis and outcomes of the team's investigation. Please characterize each of the f...","TertiaryAttribute":null,"Payload":{"QuestionText":"Consider the <b>analysis and outcomes<\/b> of the team's investigation. Please characterize each of the following aspects of Team Ostrich's <b>analysis and outcomes<\/b> as either a strength or weakness of their methods.","DefaultChoices":false,"DataExportTag":"Q157","QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","ChoiceColumnWidth":25,"RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true},"QuestionDescription":"Consider the analysis and outcomes of the team's investigation. Please characterize each of the f...","Choices":{"10":{"Display":"Other (Please describe)","TextEntry":"true","InputWidth":119,"TextEntryForceResponse":true},"79":{"Display":"Their explanations and descriptions of their methods"},"80":{"Display":"Their analysis and calculations"},"83":{"Display":"How well the line fits to the data"},"84":{"Display":"The uncertainty in their data and the spring constant (k) values"}},"ChoiceGroups":{"cg_1":{"ChoiceGroupOrder":["79","80","83","84"],"GroupLabel":"Analysis and outcomes","Options":[]}},"ChoiceGroupOrder":["cg_1","10"],"ChoiceOrder":["79","80","83","84","10"],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":85,"NextAnswerId":11,"Answers":{"6":{"Display":"Weakness (1)"},"7":{"Display":"(2)"},"9":{"Display":"(3)"},"10":{"Display":"Strength (4)"}},"AnswerOrder":["6","7","9","10"],"ChoiceDataExportTags":false,"QuestionID":"QID325"}},{"SurveyID":"SV_3ej1HpRwjR63YKa","Element":"SQ","PrimaryAttribute":"QID326","SecondaryAttribute":"As you were taking the survey, who did you picture when you were thinking of the groups?","TertiaryAttribute":null,"Payload":{"QuestionText":"As you were taking the survey, who did you picture when you were thinking of the groups?","DataExportTag":"Q158","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"As you were taking the survey, who did you picture when you were thinking of the groups?","Choices":{"1":{"Display":"Students"},"4":{"Display":"Expert Scientists"},"5":{"Display":"Other, please describe:","TextEntry":"true"}},"ChoiceOrder":["1","4","5"],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionID":"QID326","DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_3ej1HpRwjR63YKa","Element":"SQ","PrimaryAttribute":"QID327","SecondaryAttribute":"Below are the notes Group 1 made in their lab book. You will then be asked about their data and m...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div>Below are the notes Group 1 made in their lab book. You will then be asked about their data and methods.&nbsp;<\/div>\n\n<div>&nbsp;<\/div>\n<strong><span style=\"font-size:19px;\"><span style=\"font-family:arial,helvetica,sans-serif;\">Group 1: Lab book notes<\/span><\/span><br>\n<span style=\"font-family:Courier New,Courier,monospace;\"><span style=\"font-size:19px;\"><u>Method<\/u><\/span><\/span><\/strong><br>\n<span style=\"font-family:Courier New,Courier,monospace;\"><span style=\"font-size:16px;\">To test the model (<i>T=2<\/i>\u213c\u221a(<i>m\u2044k<\/i>)), we found the period, <i>T<\/i>, for two different masses, then calculated and compared the two <i>k<\/i>-values (the values should be the same because it's the same spring). <\/span><\/span>\n\n<ul>\n\t<li><span style=\"font-family:Courier New,Courier,monospace;\"><span style=\"font-size:16px;\">Put 20 g on the holder (holder is 10 g, so total is 30 g).<\/span><\/span><\/li>\n\t<li><span style=\"font-family:Courier New,Courier,monospace;\"><span style=\"font-size:16px;\">Use the stopwatch to measure the time for 5 bounces (periods).<\/span><\/span><\/li>\n\t<li><span style=\"font-family:Courier New,Courier,monospace;\"><span style=\"font-size:16px;\">Divide the time by 5 to get the period, <i> T<\/i>.<\/span><\/span><\/li>\n\t<li><span style=\"font-family:Courier New,Courier,monospace;\"><span style=\"font-size:16px;\">Repeat 10 times, find the mean period and the&nbsp;uncertainty in the mean period. <\/span><\/span><\/li>\n\t<li><span style=\"font-family:Courier New,Courier,monospace;\"><span style=\"font-size:16px;\">Repeat with 40 g on the holder (total of 50 g hanging). <\/span><\/span><\/li>\n<\/ul>\n<u><strong><span style=\"font-family:Courier New,Courier,monospace;\"><span style=\"font-size:19px;\"> Data<\/span><\/span> <\/strong><\/u><br>\n<span style=\"font-family:Courier New,Courier,monospace;\"><span style=\"font-size:16px;\">The table shows our data for each mass. First column for each mass is the total time for five bounces. Second column is the period (total time divided by five).<\/span><\/span>\n\n<table id=\"t01\" style=\"font-family:Courier New,Courier,monospace;\">\n\t<thead>\n\t\t<tr>\n\t\t\t<th colspan=\"2\">Total mass = 30 g<\/th>\n\t\t\t<th colspan=\"2\">Total mass = 50 g<\/th>\n\t\t<\/tr>\n\t<\/thead>\n\t<tbody>\n\t\t<tr>\n\t\t\t<td>Time for 5 bounces (s)<\/td>\n\t\t\t<td>Period (s)<\/td>\n\t\t\t<td>Time for 5 bounces (s)<\/td>\n\t\t\t<td>Period (s)<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td>2.78<\/td>\n\t\t\t<td>0.556<\/td>\n\t\t\t<td>3.39<\/td>\n\t\t\t<td>0.678<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td>2.68<\/td>\n\t\t\t<td>0.536<\/td>\n\t\t\t<td>3.35<\/td>\n\t\t\t<td>0.670<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td>2.76<\/td>\n\t\t\t<td>0.552<\/td>\n\t\t\t<td>3.40<\/td>\n\t\t\t<td>0.680<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td>2.70<\/td>\n\t\t\t<td>0.540<\/td>\n\t\t\t<td>3.42<\/td>\n\t\t\t<td>0.684<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td>2.67<\/td>\n\t\t\t<td>0.534<\/td>\n\t\t\t<td>3.40<\/td>\n\t\t\t<td>0.680<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td>2.82<\/td>\n\t\t\t<td>0.564<\/td>\n\t\t\t<td>3.45<\/td>\n\t\t\t<td>0.690<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td>2.66<\/td>\n\t\t\t<td>0.532<\/td>\n\t\t\t<td>3.31<\/td>\n\t\t\t<td>0.662<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td>2.72<\/td>\n\t\t\t<td>0.544<\/td>\n\t\t\t<td>3.55<\/td>\n\t\t\t<td>0.710<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td>2.56<\/td>\n\t\t\t<td>0.512<\/td>\n\t\t\t<td>3.60<\/td>\n\t\t\t<td>0.720<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td>2.57<\/td>\n\t\t\t<td>0.514<\/td>\n\t\t\t<td>3.46<\/td>\n\t\t\t<td>0.692<\/td>\n\t\t<\/tr>\n\t<\/tbody>\n<\/table>\n<br>\n<span style=\"font-family:Courier New,Courier,monospace;\"><span style=\"font-size:16px;\">Average period for 30 g mass = <i>0.5384 \u00b1 0.00531 s <\/i><br>\n=&gt;&nbsp;<i>k<\/i>-value = <i>4\u213c<sup>2<\/sup>m\/T<sup>2<\/sup><\/i> = <i> 4.086 \u00b1 0.0807 N\/m <\/i><br>\nAverage period for 50 g mass = <i>0.6866 \u00b1 0.00553 s <\/i><br>\n=&gt;&nbsp;<i>k<\/i>-value = <i>4\u213c<sup>2<\/sup>m\/T<sup>2<\/sup><\/i> = <i> 4.187 \u00b1 0.0675 N\/m <\/i> <\/span><\/span>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Below are the notes Group 1 made in their lab book. You will then be asked about their data and m...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"DataVisibility":{"Private":false,"Hidden":false},"NextChoiceId":1,"NextAnswerId":1,"QuestionText_Unsafe":"<style type=\"text\/css\">table#t01 th {\n  text-align: center;\n background-color: black;\n color: white;\n}\ntable#t01 td {\n  text-align: right;\n}\ntable#t01 tr:nth-child(even) {\n background-color: #eee;\n}\ntable#t01 tr:nth-child(odd){\n background-color: #fff;\n}\n<\/style>\n<div>Below are the notes Group 1 made in their lab book. You will then be asked about their data and methods.&nbsp;<\/div>\n\n<div>&nbsp;<\/div>\n<strong><span style=\"font-size:19px;\"><span style=\"font-family:arial,helvetica,sans-serif;\">Group 1: Lab book notes<\/span><\/span><br \/>\n<span style=\"font-family:Courier New,Courier,monospace;\"><span style=\"font-size:19px;\"><u>Method<\/u><\/span><\/span><\/strong><br \/>\n<span style=\"font-family:Courier New,Courier,monospace;\"><span style=\"font-size:16px;\">To test the model (<i>T=2<\/i>\u213c&radic;(<i>m&frasl;k<\/i>)), we found the period, <i>T<\/i>, for two different masses, then calculated and compared the two <i>k<\/i>-values (the values should be the same because it&#39;s the same spring). <\/span><\/span>\n\n<ul>\n\t<li><span style=\"font-family:Courier New,Courier,monospace;\"><span style=\"font-size:16px;\">Put 20 g on the holder (holder is 10 g, so total is 30 g).<\/span><\/span><\/li>\n\t<li><span style=\"font-family:Courier New,Courier,monospace;\"><span style=\"font-size:16px;\">Use the stopwatch to measure the time for 5 bounces (periods).<\/span><\/span><\/li>\n\t<li><span style=\"font-family:Courier New,Courier,monospace;\"><span style=\"font-size:16px;\">Divide the time by 5 to get the period, <i> T<\/i>.<\/span><\/span><\/li>\n\t<li><span style=\"font-family:Courier New,Courier,monospace;\"><span style=\"font-size:16px;\">Repeat 10 times, find the mean period and the&nbsp;uncertainty in the mean period. <\/span><\/span><\/li>\n\t<li><span style=\"font-family:Courier New,Courier,monospace;\"><span style=\"font-size:16px;\">Repeat with 40 g on the holder (total of 50 g hanging). <\/span><\/span><\/li>\n<\/ul>\n<u><strong><span style=\"font-family:Courier New,Courier,monospace;\"><span style=\"font-size:19px;\"> Data<\/span><\/span> <\/strong><\/u><br \/>\n<span style=\"font-family:Courier New,Courier,monospace;\"><span style=\"font-size:16px;\">The table shows our data for each mass. First column for each mass is the total time for five bounces. Second column is the period (total time divided by five).<\/span><\/span>\n\n<table id=\"t01\" style=\"font-family:Courier New,Courier,monospace;\">\n\t<thead>\n\t\t<tr>\n\t\t\t<th colspan=\"2\">Total mass = 30 g<\/th>\n\t\t\t<th colspan=\"2\">Total mass = 50 g<\/th>\n\t\t<\/tr>\n\t<\/thead>\n\t<tbody>\n\t\t<tr>\n\t\t\t<td>Time for 5 bounces (s)<\/td>\n\t\t\t<td>Period (s)<\/td>\n\t\t\t<td>Time for 5 bounces (s)<\/td>\n\t\t\t<td>Period (s)<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td>2.78<\/td>\n\t\t\t<td>0.556<\/td>\n\t\t\t<td>3.39<\/td>\n\t\t\t<td>0.678<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td>2.68<\/td>\n\t\t\t<td>0.536<\/td>\n\t\t\t<td>3.35<\/td>\n\t\t\t<td>0.670<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td>2.76<\/td>\n\t\t\t<td>0.552<\/td>\n\t\t\t<td>3.40<\/td>\n\t\t\t<td>0.680<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td>2.70<\/td>\n\t\t\t<td>0.540<\/td>\n\t\t\t<td>3.42<\/td>\n\t\t\t<td>0.684<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td>2.67<\/td>\n\t\t\t<td>0.534<\/td>\n\t\t\t<td>3.40<\/td>\n\t\t\t<td>0.680<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td>2.82<\/td>\n\t\t\t<td>0.564<\/td>\n\t\t\t<td>3.45<\/td>\n\t\t\t<td>0.690<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td>2.66<\/td>\n\t\t\t<td>0.532<\/td>\n\t\t\t<td>3.31<\/td>\n\t\t\t<td>0.662<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td>2.72<\/td>\n\t\t\t<td>0.544<\/td>\n\t\t\t<td>3.55<\/td>\n\t\t\t<td>0.710<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td>2.56<\/td>\n\t\t\t<td>0.512<\/td>\n\t\t\t<td>3.60<\/td>\n\t\t\t<td>0.720<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td>2.57<\/td>\n\t\t\t<td>0.514<\/td>\n\t\t\t<td>3.46<\/td>\n\t\t\t<td>0.692<\/td>\n\t\t<\/tr>\n\t<\/tbody>\n<\/table>\n<br \/>\n<span style=\"font-family:Courier New,Courier,monospace;\"><span style=\"font-size:16px;\">Average period for 30 g mass = <i>0.5384 &plusmn; 0.00531 s <\/i><br \/>\n=&gt;&nbsp;<i>k<\/i>-value = <i>4\u213c<sup>2<\/sup>m\/T<sup>2<\/sup><\/i> = <i> 4.086 &plusmn; 0.0807 N\/m <\/i><br \/>\nAverage period for 50 g mass = <i>0.6866 &plusmn; 0.00553 s <\/i><br \/>\n=&gt;&nbsp;<i>k<\/i>-value = <i>4\u213c<sup>2<\/sup>m\/T<sup>2<\/sup><\/i> = <i> 4.187 &plusmn; 0.0675 N\/m <\/i> <\/span><\/span>","DataExportTag":"Q1","QuestionID":"QID327"}},{"SurveyID":"SV_3ej1HpRwjR63YKa","Element":"SQ","PrimaryAttribute":"QID328","SecondaryAttribute":"What do you think Group 1 should say about whether their data agree with the model?","TertiaryAttribute":null,"Payload":{"QuestionText":"What do you think Group 1 should say about whether their data agree with the model?","DefaultChoices":false,"QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","LabelPosition":"BELOW"},"QuestionDescription":"What do you think Group 1 should say about whether their data agree with the model?","Choices":{"1":{"Display":"The data support the model."},"2":{"Display":"The data refute the model."},"3":{"Display":"There is not enough evidence to say either way."},"5":{"Display":"The data neither support nor refute the model."}},"ChoiceOrder":["1","2","5","3"],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"DataVisibility":{"Private":false,"Hidden":false},"NextChoiceId":6,"NextAnswerId":1,"QuestionText_Unsafe":"<div><span id=\"docs-internal-guid-46808b60-7fff-3724-310a-e18d41a93d0f\"><span style=\"font-size: 11pt; font-family: Arial; color: rgb(0, 0, 0); background-color: transparent; font-variant-numeric: normal; font-variant-east-asian: normal; vertical-align: baseline; white-space: pre-wrap;\">What do you think Group 1 should say about whether their data agree<\/span><\/span><span style=\"background-color: transparent; color: rgb(0, 0, 0); font-family: Arial; font-size: 11pt; white-space: pre-wrap;\"> with the model?<\/span><\/div>","DataExportTag":"Q1a","QuestionID":"QID328","RecodeValues":{"1":"1","2":"2","3":"4","5":"3"}}},{"SurveyID":"SV_3ej1HpRwjR63YKa","Element":"SQ","PrimaryAttribute":"QID329","SecondaryAttribute":"Which statements below support your reasoning for whether Group 1's data agree with the model? Se...","TertiaryAttribute":null,"Payload":{"QuestionText":"Which statements below support your reasoning for whether Group 1's data agree with the model? Select the most important statements (no more than two).","DefaultChoices":false,"QuestionType":"MC","Selector":"MACOL","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","NumColumns":2,"TextPosition":"inline"},"QuestionDescription":"Which statements below support your reasoning for whether Group 1's data agree with the model? Se...","Choices":{"2":{"Display":"The two spring constant values are not exactly the same"},"5":{"Display":"The two spring constant values do not agree within experimental uncertainties"},"8":{"Display":"The percent difference between the spring constant values is large"},"19":{"Display":"Other (Please describe)","TextEntry":"true","InputHeight":29,"InputWidth":146,"TextEntryValidation":"ValidTextOnly"},"28":{"Display":"The size of the uncertainty (or variability between measurements) is large"},"33":{"Display":"The two spring constant values agree within experimental uncertainties"},"34":{"Display":"The percent difference between the spring constant values is small"},"36":{"Display":"The size of the uncertainty (or variability between measurements) is small"},"37":{"Display":"The two spring constant values are similar"}},"ChoiceOrder":["2","5","8","28","19","37","33","34","36"],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"CustomValidation","CustomValidation":{"Logic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID329\/SelectedChoicesCount","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">Which statements below support your reasoning for whether Group 1's data agree with the model? Select the most important statements (no more than two).<\/span> <span class=\"LeftOpDesc\">q:\/\/QID256\/SelectedChoicesCount<\/span> <span class=\"OpDesc\">Is Less Than or Equal to<\/span> <span class=\"RightOpDesc\"> 2 <\/span>","LeftOperand":"q:\/\/QID329\/SelectedChoicesCount","LogicType":"Question","Operator":"LessThanOrEqual","QuestionID":"QID329","QuestionIDFromLocator":"QID329","QuestionIsInLoop":"no","RightOperand":"2","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression"},"Message":{"description":"Too many 3","libraryID":"UR_bOXilo3mscFKVRr","messageID":"MS_3EmA84tU2IfZVYx","subMessageID":"VE_CUSTOM_VALIDATION_1"}}}},"GradingData":[{"ChoiceID":"2","Grades":{"SC_5jsn3ykP8rziwSO":"0"},"index":0},{"ChoiceID":"5","Grades":{"SC_5jsn3ykP8rziwSO":"1"},"index":1},{"ChoiceID":"8","Grades":{"SC_5jsn3ykP8rziwSO":"0"},"index":2},{"ChoiceID":"34","Grades":{"SC_5jsn3ykP8rziwSO":"0"},"index":3},{"ChoiceID":"28","Grades":{"SC_5jsn3ykP8rziwSO":"0.5"},"index":4},{"ChoiceID":"36","Grades":{"SC_5jsn3ykP8rziwSO":"0.5"},"index":5},{"ChoiceID":"19","Grades":{"SC_5jsn3ykP8rziwSO":"0"},"index":6},{"ChoiceID":"33","Grades":{"SC_5jsn3