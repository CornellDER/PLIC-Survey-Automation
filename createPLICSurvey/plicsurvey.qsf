9,"TextEntryForceResponse":true},"51":{"Display":"Their testing of other possible variables"},"53":{"Display":"How they accounted for human error"},"55":{"Display":"The equipment they used (i.e. stopwatches)"},"57":{"Display":"The similarity of their two spring constant values (k)"},"59":{"Display":"The size of their uncertainties (or variability between data)"},"61":{"Display":"The clarity, organization, and detail of their lab notes"},"63":{"Display":"The analyses and calculations they performed"},"69":{"Display":"How they controlled for other variables"}},"ChoiceOrder":["5","1","3","51","69","53","55","57","59","61","63","10"],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":77,"NextAnswerId":4}},{"SurveyID":"SV_3ej1HpRwjR63YKa","Element":"SQ","PrimaryAttribute":"QID256","SecondaryAttribute":"Which statements below support your reasoning for whether Team Panda's data agree with the model?...","TertiaryAttribute":null,"Payload":{"QuestionText":"Which statements below support your reasoning for whether Team Panda's data agree with the model? Select the most important statements (no more than two).","DefaultChoices":false,"DataExportTag":"Q1b","QuestionID":"QID256","QuestionType":"MC","Selector":"MACOL","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","NumColumns":2,"TextPosition":"inline"},"QuestionDescription":"Which statements below support your reasoning for whether Team Panda's data agree with the model?...","Choices":{"2":{"Display":"The two spring constant values are not exactly the same"},"5":{"Display":"The two spring constant values do not agree within experimental uncertainties"},"8":{"Display":"The percent difference between the spring constant values is large"},"16":{"Display":"The average periods for the two masses are similar"},"19":{"Display":"Other (Please describe)","TextEntry":"true","InputHeight":29,"InputWidth":146,"TextEntryValidation"